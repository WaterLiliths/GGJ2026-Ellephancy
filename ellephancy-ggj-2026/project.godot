;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Fmod]

General/banks_path="res://assets/audio/FmodBanks/Desktop"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Ellephancy_GGJ2026"
run/main_scene="uid://drx8e4npnl3il"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="uid://3sehe8dgkrf5"

[autoload]

Global="*uid://bquwd2lw2fknr"
FmodManager="*res://addons/fmod/FmodManager.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/window_width_override=1280
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/defaults/default_clear_color=Color(0.3, 0.3, 0.3, 1)

[editor]

movie_writer/movie_file="D:/ggj2026/GGJ2026-Ellephancy/ellephancy-ggj-2026/videos/particulas.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/fmod/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "blue",
"res://dialogue/": "purple",
"res://escenas/": "red",
"res://scripts/": "green"
}

